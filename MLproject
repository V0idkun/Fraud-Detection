name: Fraud_Detection_v1
conda_env: conda.yaml

entry_points:
  main:
    parameters:
      data_path: {type: str, default: "data/Variant_I.csv"}
      n_estimators: {type: int, default: 100}
      learning_rate: {type: float, default: 0.1}
      use_smote: {type: float, default: False} 
    command: "python src/train.py --data_path {data_path} --n_estimators {n_estimators} --learning_rate {learning_rate}"